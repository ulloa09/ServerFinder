/* Menu bar icon and menus */
"ServerFinder — click to search, right-click for options" = "ServerFinder — haz clic para buscar, clic derecho para más opciones";
"Search Server Files" = "Buscar archivos del servidor";
"Rescan Now" = "Volver a indexar ahora";
"Settings…" = "Ajustes…";
"Quit ServerFinder" = "Salir de ServerFinder";
"Edit" = "Edición";
"Undo" = "Deshacer";
"Redo" = "Rehacer";
"Cut" = "Cortar";
"Copy" = "Copiar";
"Paste" = "Pegar";
"Select All" = "Seleccionar todo";
"Window" = "Ventana";
"Close" = "Cerrar";

/* Status */
"The search index couldn't be opened: %@" = "No se pudo abrir el índice de búsqueda: %@";
"Indexing “%@”… %@ items found" = "Indexando “%1$@”… %2$@ elementos encontrados";
"Indexing “%@”… %@ items found · %lld in queue" = "Indexando “%1$@”… %2$@ elementos encontrados · %3$lld en cola";
"No folders selected yet" = "Aún no hay carpetas seleccionadas";
"%@ items indexed" = "%@ elementos indexados";
"Not connected. Connect to the server in Finder, then rescan." = "No conectada. Conéctate al servidor en Finder y vuelve a indexar.";
"Couldn't finish indexing: %@" = "No se pudo terminar de indexar: %@";

/* Search panel */
"Search files on the server" = "Buscar archivos en el servidor";
"Clear" = "Borrar";
"Rescan all folders now" = "Volver a indexar todas las carpetas ahora";
"Settings" = "Ajustes";
"Choose what to search" = "Elige dónde buscar";
"Pick the server folders ServerFinder should index. You only need to do this once." = "Elige las carpetas del servidor que ServerFinder debe indexar. Solo tienes que hacerlo una vez.";
"Choose Folders…" = "Elegir carpetas…";
"Type part of a file name" = "Escribe parte del nombre de un archivo";
"For example “invoice”, “acme 2024” or “plan .pdf” to see only PDFs. Press Return to open the selected file." = "Por ejemplo “factura”, “acme 2024” o “plan .pdf” para ver solo PDF. Pulsa Retorno para abrir el archivo seleccionado.";
"No matches for “%@”" = "Sin resultados para “%@”";
"Try fewer letters or a different part of the name." = "Prueba con menos letras o con otra parte del nombre.";
"Still indexing — more results may appear in a moment." = "Todavía indexando: pueden aparecer más resultados en un momento.";
"“%@” is no longer on the server. Rescan to update the results." = "“%@” ya no está en el servidor. Vuelve a indexar para actualizar los resultados.";
"“%@” isn't connected. Connect to the server in Finder, then try again." = "“%@” no está conectada. Conéctate al servidor en Finder y vuelve a intentarlo.";

/* Settings */
"ServerFinder Settings" = "Ajustes de ServerFinder";
"Folders to search" = "Carpetas donde buscar";
"ServerFinder keeps a list of the file names in these folders on your Mac, so you can find any file instantly." = "ServerFinder guarda en tu Mac una lista de los nombres de archivo de estas carpetas, para que encuentres cualquier archivo al instante.";
"Add Folder…" = "Añadir carpeta…";
"Remove" = "Quitar";
"No folders yet. Add a connected server folder below." = "Aún no hay carpetas. Añade abajo una carpeta conectada del servidor.";
"Connected server folders" = "Carpetas del servidor conectadas";
"These shared folders are connected right now. Add the ones you want to search." = "Estas carpetas compartidas están conectadas ahora. Añade las que quieras buscar.";
"Add All" = "Añadir todas";
"Add" = "Añadir";
"Choose the server folders you want to search." = "Elige las carpetas del servidor donde quieres buscar.";
"“%@” is already searched as part of “%@”." = "“%1$@” ya se busca como parte de “%2$@”.";
"ServerFinder only reads file names. It never changes, moves or deletes anything on the server." = "ServerFinder solo lee nombres de archivo. Nunca cambia, mueve ni elimina nada en el servidor.";
"Indexing… %@ found" = "Indexando… %@ encontrados";
"Waiting to index…" = "En espera para indexar…";
"%@ items" = "%@ elementos";
"Updated %@" = "Actualizado %@";
"Not indexed yet" = "Aún sin indexar";
"Not connected" = "No conectada";

/* Result actions */
"Open" = "Abrir";
"Show in Finder" = "Mostrar en Finder";
"Copy Path" = "Copiar ruta";
"Path copied" = "Ruta copiada";
"↩ Open   ⌘↩ Show in Finder   ⌘C Copy Path" = "↩ Abrir   ⌘↩ Mostrar en Finder   ⌘C Copiar ruta";

/* General settings */
"Folders" = "Carpetas";
"General" = "General";
"Search shortcut" = "Atajo para buscar";
"Press it in any app to open the search. Click the shortcut to change it." = "Púlsalo en cualquier app para abrir la búsqueda. Haz clic en el atajo para cambiarlo.";
"Press the new shortcut…" = "Pulsa el nuevo atajo…";
"None — click to set" = "Ninguno: haz clic para elegir";
"Turn off the shortcut" = "Desactivar el atajo";
"Space" = "Espacio";
"Another app is already using this shortcut. Choose a different one." = "Otra app ya usa este atajo. Elige uno diferente.";
"Tip: press %@ in any app to open this search." = "Consejo: pulsa %@ en cualquier app para abrir esta búsqueda.";
"Open ServerFinder when you log in" = "Abrir ServerFinder al iniciar sesión";
"macOS needs your approval in Login Items." = "macOS necesita tu aprobación en Ítems de inicio.";
"Open Login Items Settings" = "Abrir ajustes de Ítems de inicio";
"Couldn't change this setting: %@" = "No se pudo cambiar este ajuste: %@";

/* Safe rescans */
"The connection to the server was lost while indexing. The previous list was kept." = "Se perdió la conexión con el servidor mientras se indexaba. Se conservó la lista anterior.";
"%lld folders couldn't be read" = "%lld carpetas no se pudieron leer";
"You don't have permission to open these folders, so their files aren't searchable:" = "No tienes permiso para abrir estas carpetas, así que sus archivos no aparecen en la búsqueda:";

/* Exclusions */
"Excluded" = "Excluidos";
"Leave out of the search" = "Dejar fuera de la búsqueda";
"Files and folders with these names aren't indexed. Excluded folders aren't even opened, which also makes scans faster." = "Los archivos y carpetas con estos nombres no se indexan. Las carpetas excluidas ni siquiera se abren, lo que además acelera el indexado.";
"Nothing is excluded." = "No hay nada excluido.";
"Name or pattern, e.g. *.tmp" = "Nombre o patrón, p. ej. *.tmp";
"Examples: Thumbs.db · ~$* (Office temporary files) · *.tmp · Backups/Old (a folder inside a shared folder). * means any text, ? one character. Capitals don't matter." = "Ejemplos: Thumbs.db · ~$* (archivos temporales de Office) · *.tmp · Respaldos/Antiguos (una carpeta dentro de una carpeta compartida). * es cualquier texto, ? un solo carácter. No importan las mayúsculas.";
"Restore Windows Defaults" = "Restaurar valores de Windows";
"Changes apply the next time folders are indexed." = "Los cambios se aplican la próxima vez que se indexen las carpetas.";

/* Status menu */
"%@ items · updated %@" = "%1$@ elementos · actualizado %2$@";

/* Automatic scanning */
"Rescan automatically" = "Volver a indexar automáticamente";
"Every hour" = "Cada hora";
"Every 2 hours" = "Cada 2 horas";
"Every 4 hours" = "Cada 4 horas";
"Every 8 hours" = "Cada 8 horas";
"Once a day" = "Una vez al día";
"Only when a folder connects" = "Solo cuando se conecta una carpeta";
"Folders are also scanned when their server connects and when ServerFinder starts. Searching always works with the last list, even while scanning." = "Las carpetas también se indexan cuando su servidor se conecta y cuando ServerFinder se abre. La búsqueda siempre funciona con la última lista, incluso mientras se indexa.";
