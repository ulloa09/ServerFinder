/* Exclusions */
"Excluded" = "Excluidos";
"Leave out of the search" = "Dejar fuera de la búsqueda";
"Files and folders with these names aren't indexed. Excluded folders aren't even opened, which also makes scans faster." = "Los archivos y carpetas con estos nombres no se indexan. Las carpetas excluidas ni siquiera se abren, lo que además acelera el indexado.";
"Nothing is excluded." = "No hay nada excluido.";
"Name or pattern, e.g. *.tmp" = "Nombre o patrón, p. ej. *.tmp";
"Examples: Thumbs.db · ~$* (Office temporary files) · *.tmp · Backups/Old (a folder inside a shared folder). * means any text, ? one character. Capitals don't matter." = "Ejemplos: Thumbs.db · ~$* (archivos temporales de Office) · *.tmp · Respaldos/Antiguos (una carpeta dentro de una carpeta compartida). * es cualquier texto, ? un solo carácter. No importan las mayúsculas.";
"Restore Windows Defaults" = "Restaurar valores de Windows";
"Changes apply the next time folders are indexed." = "Los cambios se aplican la próxima vez que se indexen las carpetas.";

/* Status menu */
"%@ items · updated %@" = "%1$@ elementos · actualizado %2$@";

